#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// M2 debug view: primary rays through the TLAS, visualizing normals, depth
// or instance IDs to validate the RT scene against the raster scene.

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform accelerationStructureEXT tlas;
layout(binding = 1, rgba16f) uniform image2D outImage;

layout(buffer_reference, std430, buffer_reference_align = 4) buffer FloatBuf { float f[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) buffer UintBuf { uint u[]; };

struct GeomRecord {
	uint64_t vtx;
	uint64_t idx;
	uint albedo;	// packed RGBA8
	uint pad;
};
layout(binding = 2, std430) readonly buffer Records { GeomRecord records[]; };

layout(push_constant) uniform PC {
	vec4 camPos;	// xyz = position
	vec4 camRight;	// xyz = right, w = viewWindow.x
	vec4 camUp;	// xyz = up, w = viewWindow.y
	vec4 camFwd;	// xyz = forward
	uvec2 size;
	uint mode;	// 1 = normals, 2 = depth, 3 = instances
	uint frame;
} pc;

vec3 hashColor(uint n)
{
	n = n*747796405u + 2891336453u;
	n = ((n >> ((n >> 28) + 4u)) ^ n) * 277803737u;
	n = (n >> 22) ^ n;
	return vec3(float(n & 255u), float((n >> 8) & 255u), float((n >> 16) & 255u)) / 255.0;
}

void main()
{
	uvec2 px = gl_GlobalInvocationID.xy;
	if(px.x >= pc.size.x || px.y >= pc.size.y)
		return;

	vec2 uv = (vec2(px) + 0.5) / vec2(pc.size);
	float u = uv.x*2.0 - 1.0;
	float v = uv.y*2.0 - 1.0;
	// RW camera space: right vector points screen-left, hence the negation
	vec3 dir = normalize(pc.camFwd.xyz - pc.camRight.xyz*(u*pc.camRight.w) + pc.camUp.xyz*(v*pc.camUp.w));

	uint state = px.x*7919u + px.y*104729u + pc.frame*15485863u;
	rayQueryEXT rq;
	rayQueryInitializeEXT(rq, tlas, gl_RayFlagsNoneEXT, 0xFF, pc.camPos.xyz, 0.1, dir, 3000.0);
	while(rayQueryProceedEXT(rq)){
		if(rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionTriangleEXT
		   && hashColor(state++).x < 0.45)
			rayQueryConfirmIntersectionEXT(rq);
	}

	vec3 color;
	if(rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionTriangleEXT){
		float t = rayQueryGetIntersectionTEXT(rq, true);
		uint inst = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true));
		uint geomIdx = uint(rayQueryGetIntersectionGeometryIndexEXT(rq, true));
		uint prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));

		if(pc.mode == 2u){
			float d = exp(-t * 0.01);
			color = vec3(d);
		}else if(pc.mode == 3u){
			color = hashColor(rayQueryGetIntersectionInstanceIdEXT(rq, true));
		}else{
			GeomRecord rec = records[inst + geomIdx];
			UintBuf ib = UintBuf(rec.idx);
			FloatBuf vb = FloatBuf(rec.vtx);
			uint i0 = ib.u[prim*3u+0u];
			uint i1 = ib.u[prim*3u+1u];
			uint i2 = ib.u[prim*3u+2u];
			vec3 p0 = vec3(vb.f[i0*3u], vb.f[i0*3u+1u], vb.f[i0*3u+2u]);
			vec3 p1 = vec3(vb.f[i1*3u], vb.f[i1*3u+1u], vb.f[i1*3u+2u]);
			vec3 p2 = vec3(vb.f[i2*3u], vb.f[i2*3u+1u], vb.f[i2*3u+2u]);
			mat4x3 objToWorld = rayQueryGetIntersectionObjectToWorldEXT(rq, true);
			vec3 n = normalize(mat3(objToWorld) * cross(p1 - p0, p2 - p0));
			// two-sided: face the camera
			if(dot(n, dir) > 0.0)
				n = -n;
			color = n*0.5 + 0.5;
		}
	}else{
		// simple sky gradient on miss
		float h = clamp(dir.z*2.0 + 0.3, 0.0, 1.0);
		color = mix(vec3(0.55, 0.75, 0.95), vec3(0.15, 0.35, 0.8), h);
	}

	imageStore(outImage, ivec2(px), vec4(color, 1.0));
}
