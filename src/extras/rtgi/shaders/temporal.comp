#version 460

// Temporal accumulation for the GI buffer: reproject the previous frame's
// accumulation with the previous camera, validate by depth, blend.

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform image2D giRaw;
layout(binding = 1) uniform sampler2D prevAccum;
layout(binding = 2) uniform sampler2D prevDepth;
layout(binding = 3) uniform sampler2D gbDepth;
layout(binding = 4, rgba16f) uniform image2D outAccum;
layout(binding = 5, rgba16f) uniform image2D outShared;	// GL-visible copy
layout(binding = 6, r32f) uniform image2D outPrevDepth;	// depth for next frame
layout(binding = 7) uniform sampler2D prevMoments;	// r = E[lum], g = E[lum^2], b = history length
layout(binding = 8, rgba16f) uniform image2D outMoments;
layout(binding = 9) uniform sampler2D aoRaw;		// r = 1spp AO, g = sun visibility
layout(binding = 10) uniform sampler2D prevAoAccum;
layout(binding = 11, r16f) uniform image2D outAoAccum;
layout(binding = 12, rg16f) uniform image2D outAoShared;	// GL-visible: r = smoothed AO, g = fresh sun vis

layout(push_constant) uniform PC {
	vec4 camPos;
	vec4 camRight;	// w = viewWindow.x
	vec4 camUp;	// w = viewWindow.y
	vec4 camFwd;
	vec4 prevCamPos;
	vec4 prevCamRight;
	vec4 prevCamUp;
	vec4 prevCamFwd;
	uvec2 size;
	uint frame;
	uint reset;	// 1 = drop history (scene load, camera cut)
	uint photo;	// 1 = progressive average (still camera), no blend floor
	uint checker;	// 1 = GI traced only alternating pixels this frame
	uint pad2, pad3;
} pc;

void main()
{
	uvec2 px = gl_GlobalInvocationID.xy;
	if(px.x >= pc.size.x || px.y >= pc.size.y)
		return;

	vec2 uv = (vec2(px) + 0.5) / vec2(pc.size);
	float depth = texelFetch(gbDepth, ivec2(px), 0).r;
	vec3 cur = imageLoad(giRaw, ivec2(px)).rgb;
	float lum = dot(cur, vec3(0.299, 0.587, 0.114));
	vec2 aoCur = texelFetch(aoRaw, ivec2(px), 0).rg;

	vec3 result = cur;
	float aoResult = aoCur.r;
	// luminance moments drive the denoiser's variance estimate; history
	// length lets fresh disocclusions converge fast, then settle
	vec3 moments = vec3(lum, lum*lum, 1.0);
	if(pc.reset == 0u && depth > 0.0){
		// world position of this pixel
		float u = uv.x*2.0 - 1.0;
		float v = uv.y*2.0 - 1.0;
		vec3 viewRay = pc.camFwd.xyz - pc.camRight.xyz*(u*pc.camRight.w) + pc.camUp.xyz*(v*pc.camUp.w);
		vec3 worldPos = pc.camPos.xyz + viewRay*depth;

		// project into the previous camera
		vec3 d = worldPos - pc.prevCamPos.xyz;
		float pz = dot(d, pc.prevCamFwd.xyz);
		if(pz > 0.1){
			float pxn = -dot(d, pc.prevCamRight.xyz) / (pz * pc.prevCamRight.w);
			float pyn = dot(d, pc.prevCamUp.xyz) / (pz * pc.prevCamUp.w);
			vec2 prevUv = vec2(pxn*0.5 + 0.5, pyn*0.5 + 0.5);
			if(all(greaterThan(prevUv, vec2(0.001))) && all(lessThan(prevUv, vec2(0.999)))){
				float pd = texture(prevDepth, prevUv).r;
				// depth the reprojected point should have in the old camera
				if(pd > 0.0 && abs(pd - pz) / pz < 0.05){
					vec3 hist = texture(prevAccum, prevUv).rgb;
					vec3 prevM = texture(prevMoments, prevUv).rgb;

					// camera-only reprojection cannot reject history
					// under a MOVING occluder (the ground pixel passes
					// the depth test, but last frame's shading still
					// holds the car's shadow/occlusion) — fast cars
					// smear their shadow backward. Clamp history into
					// the current 3x3 raw neighborhood (mean +/- k*sigma,
					// as the reflection temporal already does); photo
					// mode must keep the unclamped true average
					vec3 nbMean = vec3(0.0), nbM2 = vec3(0.0);
					float aoMean = 0.0, aoM2 = 0.0;
					for(int oy = -1; oy <= 1; oy++)
					for(int ox = -1; ox <= 1; ox++){
						ivec2 q = clamp(ivec2(px) + ivec2(ox, oy),
							ivec2(0), ivec2(pc.size) - 1);
						vec3 s = imageLoad(giRaw, q).rgb;
						nbMean += s; nbM2 += s*s;
						float a = texelFetch(aoRaw, q, 0).r;
						aoMean += a; aoM2 += a*a;
					}
					nbMean /= 9.0; aoMean /= 9.0;
					vec3 nbSig = sqrt(max(nbM2/9.0 - nbMean*nbMean, 0.0));
					float aoSig = sqrt(max(aoM2/9.0 - aoMean*aoMean, 0.0));
					// checkerboard: pixels in untraced 8x8 tiles carry
					// their history forward unchanged (must mirror the
					// workgroup predicate in gi.comp)
					bool traced = !(pc.checker != 0u &&
						((px.x/8u + px.y/8u + pc.frame) & 1u) == 1u);
					float nCap = pc.photo != 0u ? 4096.0 : 64.0;
					float n = min(prevM.b + (traced ? 1.0 : 0.0), nCap);
					// photo mode converges to the true average; gameplay
					// keeps a responsive blend floor
					float alphaC = pc.photo != 0u ? 1.0/n : max(1.0/n, 0.08);
					float alphaM = pc.photo != 0u ? 1.0/n : max(1.0/n, 0.2);
					if(!traced){
						alphaC = 0.0;
						alphaM = 0.0;
					}
					// 1spp raw stats are noisy, so clamp loosely (2 sigma):
					// tight enough to cut multi-frame trails, loose enough
					// that stable regions keep their converged history
					if(pc.photo == 0u && traced)
						hist = clamp(hist, nbMean - 2.0*nbSig, nbMean + 2.0*nbSig);
					result = mix(hist, cur, alphaC);
					moments.r = mix(prevM.r, lum, alphaM);
					moments.g = mix(prevM.g, lum*lum, alphaM);
					moments.b = n;

					// AO is traced every frame (no checkerboard); the
					// noisy cosine-hemisphere term smooths out here
					float aoHist = texture(prevAoAccum, prevUv).r;
					float alphaAo = pc.photo != 0u ? 1.0/n : max(1.0/n, 0.2);
					// AO is a single clean cosine ray - clamp much
					// tighter than GI (1 sigma) and blend faster
					// (floor 0.2): the user still saw the under-car
					// darkening trail behind fast traffic at 1.5 sigma
					if(pc.photo == 0u)
						aoHist = clamp(aoHist, aoMean - aoSig, aoMean + aoSig);
					aoResult = mix(aoHist, aoCur.r, alphaAo);
				}
			}
		}
	}

	imageStore(outAccum, ivec2(px), vec4(result, 1.0));
	imageStore(outShared, ivec2(px), vec4(result, 1.0));
	imageStore(outPrevDepth, ivec2(px), vec4(depth, 0.0, 0.0, 0.0));
	imageStore(outMoments, ivec2(px), vec4(moments, 0.0));
	imageStore(outAoAccum, ivec2(px), vec4(aoResult, 0.0, 0.0, 0.0));
	// sun visibility passes through fresh: it is a single deterministic
	// ray, and blending it would trail moving shadows
	imageStore(outAoShared, ivec2(px), vec4(aoResult, aoCur.g, 0.0, 0.0));
}
