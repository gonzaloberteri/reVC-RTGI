#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_nonuniform_qualifier : require

// One-bounce diffuse GI from the G-buffer: a cosine-hemisphere ray per pixel;
// sky radiance on miss, sun-lit surface albedo on hit (with a sun shadow ray
// from the hit point). Output is raw 1spp radiance; the temporal pass
// accumulates it.

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform accelerationStructureEXT tlas;
layout(binding = 1, rgba16f) uniform image2D giRaw;
layout(binding = 2) uniform sampler2D gbNormal;
layout(binding = 3) uniform sampler2D gbDepth;

layout(buffer_reference, std430, buffer_reference_align = 4) buffer FloatBuf { float f[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) buffer UintBuf { uint u[]; };

struct GeomRecord {
	uint64_t vtx;
	uint64_t idx;
	uint64_t uv;	// vec2 texcoords, 0 when the mesh has none
	uint albedo;	// mean-color fallback
	uint emissive;	// RGBA8 emitted color (night windows/neon); 0 = none
	uint texSlot;	// texture cache slot; ~0u = none
	uint matColor;	// RGBA8 plain material color
};
layout(binding = 4, std430) readonly buffer Records { GeomRecord records[]; };
layout(binding = 6) uniform sampler2D texCache[];	// real hit albedo

struct PointLight {
	vec4 posRadius;	// xyz, w = radius
	vec4 color;	// rgb, w = spot cos cutoff (0 = omni)
	vec4 dir;	// xyz spot direction (headlight cones)
};
layout(binding = 5, std430) readonly buffer Lights { PointLight lights[]; };

layout(push_constant) uniform PC {
	vec4 camPos;
	vec4 camRight;	// w = viewWindow.x
	vec4 camUp;	// w = viewWindow.y
	vec4 camFwd;
	vec4 sunDir;	// xyz to sun, w > 0 when up
	vec4 sunColor;	// rgb, w = emissive boost
	vec4 skyTop;	// rgb, w = second-bounce RR probability (0 = single bounce)
	vec4 skyBottom;	// rgb, w = checkerboard enable
	uvec2 size;
	uint frame;
	uint numLights;
} pc;

uint pcg(inout uint state)
{
	state = state*747796405u + 2891336453u;
	uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
	return (word >> 22u) ^ word;
}

float rnd(inout uint state)
{
	return float(pcg(state)) / 4294967296.0;
}

vec3 cosineHemisphere(vec3 n, inout uint state)
{
	float r1 = rnd(state);
	float r2 = rnd(state);
	float phi = 6.2831853 * r1;
	float sr = sqrt(r2);
	vec3 t = normalize(abs(n.z) < 0.99 ? cross(n, vec3(0,0,1)) : cross(n, vec3(1,0,0)));
	vec3 b = cross(n, t);
	return normalize(t*(cos(phi)*sr) + b*(sin(phi)*sr) + n*sqrt(1.0 - r2));
}

vec3 skyRadiance(vec3 dir)
{
	float h = clamp(dir.z, 0.0, 1.0);
	return mix(pc.skyBottom.rgb, pc.skyTop.rgb, h);
}

vec3 unpackAlbedo(uint c)
{
	return vec3(float(c & 255u), float((c >> 8) & 255u), float((c >> 16) & 255u)) / 255.0;
}

// non-opaque (alpha-tested foliage) candidates pass through stochastically
#define TRAVERSE(rq) \
	while(rayQueryProceedEXT(rq)){ \
		if(rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionTriangleEXT \
		   && rnd(state) < 0.45) \
			rayQueryConfirmIntersectionEXT(rq); \
	}

bool shadowRayHit(vec3 origin, vec3 dir, inout uint state)
{
	rayQueryEXT rq;
	rayQueryInitializeEXT(rq, tlas,
		gl_RayFlagsTerminateOnFirstHitEXT,
		0xFFu, origin, 0.05, dir, 500.0);
	TRAVERSE(rq)
	return rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

void main()
{
	uvec2 px = gl_GlobalInvocationID.xy;
	if(px.x >= pc.size.x || px.y >= pc.size.y)
		return;

	// checkerboard: trace half the 8x8 tiles per frame (whole workgroups
	// skip uniformly, so the SIMD actually saves); the temporal pass keeps
	// the other half's history untouched
	if(pc.skyBottom.w > 0.5 &&
	   ((gl_WorkGroupID.x + gl_WorkGroupID.y + pc.frame) & 1u) == 1u)
		return;

	vec2 uv = (vec2(px) + 0.5) / vec2(pc.size);
	float depth = texelFetch(gbDepth, ivec2(px), 0).r;
	vec3 normal = texelFetch(gbNormal, ivec2(px), 0).xyz;

	if(depth <= 0.0 || dot(normal, normal) < 0.5){
		imageStore(giRaw, ivec2(px), vec4(skyRadiance(vec3(0,0,1)), 1.0));
		return;
	}
	normal = normalize(normal);

	float u = uv.x*2.0 - 1.0;
	float v = uv.y*2.0 - 1.0;
	vec3 viewRay = pc.camFwd.xyz - pc.camRight.xyz*(u*pc.camRight.w) + pc.camUp.xyz*(v*pc.camUp.w);
	vec3 worldPos = pc.camPos.xyz + viewRay*depth;
	if(dot(normal, viewRay) > 0.0)
		normal = -normal;
	vec3 origin = worldPos + normal*0.05;

	uint state = px.x*7919u + px.y*104729u + pc.frame*15485863u + 77u;

	// cosine-weighted bounce: the estimator for incoming irradiance/pi is
	// simply the radiance carried back by the ray
	vec3 dir = cosineHemisphere(normal, state);

	rayQueryEXT rq;
	rayQueryInitializeEXT(rq, tlas, gl_RayFlagsNoneEXT, 0xFFu, origin, 0.02, dir, 200.0);
	TRAVERSE(rq)

	vec3 radiance;
	if(rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionTriangleEXT){
		float t = rayQueryGetIntersectionTEXT(rq, true);
		uint inst = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true));
		uint geomIdx = uint(rayQueryGetIntersectionGeometryIndexEXT(rq, true));
		uint prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));

		GeomRecord rec = records[inst + geomIdx];

		// hit geometric normal
		UintBuf ib = UintBuf(rec.idx);
		FloatBuf vb = FloatBuf(rec.vtx);
		uint i0 = ib.u[prim*3u+0u];
		uint i1 = ib.u[prim*3u+1u];
		uint i2 = ib.u[prim*3u+2u];

		// real albedo: texture fetch at the hit UV; mean color as fallback
		vec3 albedo = unpackAlbedo(rec.albedo);
		if(rec.texSlot != 0xFFFFFFFFu && rec.uv != uint64_t(0)){
			vec2 bary = rayQueryGetIntersectionBarycentricsEXT(rq, true);
			FloatBuf uvb = FloatBuf(rec.uv);
			vec2 uv0 = vec2(uvb.f[i0*2u], uvb.f[i0*2u+1u]);
			vec2 uv1 = vec2(uvb.f[i1*2u], uvb.f[i1*2u+1u]);
			vec2 uv2 = vec2(uvb.f[i2*2u], uvb.f[i2*2u+1u]);
			vec2 huv = uv0*(1.0 - bary.x - bary.y) + uv1*bary.x + uv2*bary.y;
			albedo = textureLod(texCache[nonuniformEXT(rec.texSlot)], huv, 0.0).rgb
				* unpackAlbedo(rec.matColor);
		}
		vec3 p0 = vec3(vb.f[i0*3u], vb.f[i0*3u+1u], vb.f[i0*3u+2u]);
		vec3 p1 = vec3(vb.f[i1*3u], vb.f[i1*3u+1u], vb.f[i1*3u+2u]);
		vec3 p2 = vec3(vb.f[i2*3u], vb.f[i2*3u+1u], vb.f[i2*3u+2u]);
		mat4x3 objToWorld = rayQueryGetIntersectionObjectToWorldEXT(rq, true);
		vec3 hitN = normalize(mat3(objToWorld) * cross(p1 - p0, p2 - p0));
		if(dot(hitN, dir) > 0.0)
			hitN = -hitN;

		vec3 hitPos = origin + dir*t;

		// direct sun at the hit (this is what makes light bounce off walls)
		vec3 direct = vec3(0.0);
		if(pc.sunDir.w > 0.0){
			float ndl = dot(hitN, normalize(pc.sunDir.xyz));
			if(ndl > 0.0 && !shadowRayHit(hitPos + hitN*0.05, normalize(pc.sunDir.xyz), state))
				direct = pc.sunColor.rgb * ndl;
		}
		// sky/indirect at the hit: either a crude constant sky term, or a
		// real second bounce (Russian roulette) that samples sky and
		// sun-lit surfaces properly
		vec3 skyAmb = vec3(0.0);
		float rrP = pc.skyTop.w;
		if(rrP <= 0.0)
			skyAmb = skyRadiance(hitN) * 0.35;
		else if(rnd(state) < rrP){
			vec3 dir2 = cosineHemisphere(hitN, state);
			rayQueryEXT rq2;
			rayQueryInitializeEXT(rq2, tlas, gl_RayFlagsNoneEXT,
				0xFFu, hitPos + hitN*0.05, 0.02, dir2, 100.0);
			TRAVERSE(rq2)
			if(rayQueryGetIntersectionTypeEXT(rq2, true) == gl_RayQueryCommittedIntersectionTriangleEXT){
				float t2 = rayQueryGetIntersectionTEXT(rq2, true);
				uint inst2 = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq2, true));
				uint gidx2 = uint(rayQueryGetIntersectionGeometryIndexEXT(rq2, true));
				uint prim2 = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq2, true));
				GeomRecord rec2 = records[inst2 + gidx2];
				vec3 alb2 = unpackAlbedo(rec2.albedo);	// mean color is enough this deep
				UintBuf ib2 = UintBuf(rec2.idx);
				FloatBuf vb2 = FloatBuf(rec2.vtx);
				uint j0 = ib2.u[prim2*3u+0u];
				uint j1 = ib2.u[prim2*3u+1u];
				uint j2 = ib2.u[prim2*3u+2u];
				vec3 q0 = vec3(vb2.f[j0*3u], vb2.f[j0*3u+1u], vb2.f[j0*3u+2u]);
				vec3 q1 = vec3(vb2.f[j1*3u], vb2.f[j1*3u+1u], vb2.f[j1*3u+2u]);
				vec3 q2 = vec3(vb2.f[j2*3u], vb2.f[j2*3u+1u], vb2.f[j2*3u+2u]);
				mat4x3 o2w2 = rayQueryGetIntersectionObjectToWorldEXT(rq2, true);
				vec3 hitN2 = normalize(mat3(o2w2) * cross(q1 - q0, q2 - q0));
				if(dot(hitN2, dir2) > 0.0)
					hitN2 = -hitN2;
				vec3 hp2 = hitPos + hitN*0.05 + dir2*t2;
				vec3 direct2 = vec3(0.0);
				if(pc.sunDir.w > 0.0){
					float ndl2 = dot(hitN2, normalize(pc.sunDir.xyz));
					if(ndl2 > 0.0 && !shadowRayHit(hp2 + hitN2*0.05, normalize(pc.sunDir.xyz), state))
						direct2 = pc.sunColor.rgb * ndl2;
				}
				skyAmb = alb2 * (direct2 + skyRadiance(hitN2)*0.35
					+ unpackAlbedo(rec2.emissive) * pc.sunColor.w) / rrP;
			}else
				skyAmb = skyRadiance(dir2) / rrP;
		}

		// point lights (street lamps, headlights, explosions): next-event
		// estimation with one random light
		vec3 pointLight = vec3(0.0);
		if(pc.numLights > 0u){
			uint li = pcg(state) % pc.numLights;
			PointLight L = lights[li];
			vec3 toL = L.posRadius.xyz - hitPos;
			float d = length(toL);
			if(d < L.posRadius.w && d > 0.01){
				toL /= d;
				float ndl = dot(hitN, toL);
				// spot cone (headlights): -toL is light-to-surface
				float spot = 1.0;
				if(L.color.w > 0.0){
					float cd = dot(L.dir.xyz, -toL);
					spot = smoothstep(L.color.w, L.color.w + 0.12, cd);
				}
				if(ndl > 0.0 && spot > 0.0){
					rayQueryEXT srq;
					rayQueryInitializeEXT(srq, tlas,
						gl_RayFlagsTerminateOnFirstHitEXT,
						0xFFu, hitPos + hitN*0.05, 0.02, toL, d - 0.1);
					TRAVERSE(srq)
					if(rayQueryGetIntersectionTypeEXT(srq, true) == gl_RayQueryCommittedIntersectionNoneEXT){
						float falloff = 1.0 - d/L.posRadius.w;
						pointLight = L.color.rgb * (ndl * falloff * spot * float(pc.numLights));
					}
				}
			}
		}

		// self-emission (night windows, neon): sunColor.w carries the
		// emissive boost knob
		radiance = albedo * (direct + skyAmb + pointLight)
			+ unpackAlbedo(rec.emissive) * pc.sunColor.w;
	}else{
		// sky visible from the surface: this is the sky-light term
		radiance = skyRadiance(dir);
	}

	// firefly clamp: the RR-weighted second bounce and boosted emissives
	// can spike a single sample far beyond anything the eye needs; the
	// temporal mean can't absorb rare 10x outliers without sparkling
	radiance = min(radiance, vec3(6.0));

	imageStore(giRaw, ivec2(px), vec4(radiance, 1.0));
}
