#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_nonuniform_qualifier : require

// Mirror reflections for reflective pixels: G-buffer normal.w carries per-
// surface reflectivity (vehicles from the prepass); up-facing surfaces gain
// wetness-driven reflectivity when it rains. Output a = final reflectivity.

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform accelerationStructureEXT tlas;
layout(binding = 1, rgba16f) uniform image2D reflImage;
layout(binding = 2) uniform sampler2D gbNormal;
layout(binding = 3) uniform sampler2D gbDepth;

layout(buffer_reference, std430, buffer_reference_align = 4) buffer FloatBuf { float f[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) buffer UintBuf { uint u[]; };

struct GeomRecord {
	uint64_t vtx;
	uint64_t idx;
	uint64_t uv;	// vec2 texcoords, 0 when the mesh has none
	uint albedo;	// mean-color fallback
	uint emissive;	// RGBA8 emitted color (night windows/neon); 0 = none
	uint texSlot;	// texture cache slot; ~0u = none
	uint matColor;	// RGBA8 plain material color
};
layout(binding = 4, std430) readonly buffer Records { GeomRecord records[]; };
layout(binding = 5) uniform sampler2D texCache[];	// real hit albedo

layout(push_constant) uniform PC {
	vec4 camPos;
	vec4 camRight;	// w = viewWindow.x
	vec4 camUp;	// w = viewWindow.y
	vec4 camFwd;
	vec4 sunDir;	// xyz to sun, w > 0 when up
	vec4 sunColor;
	vec4 skyTop;
	vec4 skyBottom;
	uvec2 size;
	uint frame;
	float wetness;	// 0..1 road wetness
} pc;

vec3 skyRadiance(vec3 dir)
{
	float h = clamp(dir.z, 0.0, 1.0);
	return mix(pc.skyBottom.rgb, pc.skyTop.rgb, h);
}

uint pcg(inout uint state)
{
	state = state*747796405u + 2891336453u;
	uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
	return (word >> 22u) ^ word;
}

float rnd(inout uint state)
{
	return float(pcg(state)) / 4294967296.0;
}

// non-opaque candidates (alpha-tested foliage, translucent glass) commit
// with probability = their real coverage at the hit UV (texture alpha x
// material alpha). Leaf cutout texels pass through — a mirror showing the
// black DXT background behind each leaf was the alternative — solid leaf
// texels always block, and translucent glass keeps a coverage dither the
// reflection filter smooths
float candidateAlpha(rayQueryEXT rq)
{
	uint inst = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, false));
	uint geomIdx = uint(rayQueryGetIntersectionGeometryIndexEXT(rq, false));
	GeomRecord rec = records[inst + geomIdx];
	float a = float((rec.matColor >> 24) & 255u) / 255.0;
	uint slot = rec.texSlot & 0xFFFFu;
	if(slot != 0xFFFFu && rec.uv != uint64_t(0)){
		uint prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, false));
		UintBuf ib = UintBuf(rec.idx);
		uint i0 = ib.u[prim*3u+0u];
		uint i1 = ib.u[prim*3u+1u];
		uint i2 = ib.u[prim*3u+2u];
		vec2 bary = rayQueryGetIntersectionBarycentricsEXT(rq, false);
		FloatBuf uvb = FloatBuf(rec.uv);
		vec2 huv = vec2(uvb.f[i0*2u], uvb.f[i0*2u+1u])*(1.0 - bary.x - bary.y)
			+ vec2(uvb.f[i1*2u], uvb.f[i1*2u+1u])*bary.x
			+ vec2(uvb.f[i2*2u], uvb.f[i2*2u+1u])*bary.y;
		a *= textureLod(texCache[nonuniformEXT(slot)], huv, 0.0).a;
	}
	return a;
}

#define TRAVERSE(rq) \
	while(rayQueryProceedEXT(rq)){ \
		if(rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionTriangleEXT \
		   && rnd(state) < candidateAlpha(rq)) \
			rayQueryConfirmIntersectionEXT(rq); \
	}

vec3 unpackAlbedo(uint c)
{
	return vec3(float(c & 255u), float((c >> 8) & 255u), float((c >> 16) & 255u)) / 255.0;
}

void main()
{
	uvec2 px = gl_GlobalInvocationID.xy;
	if(px.x >= pc.size.x || px.y >= pc.size.y)
		return;

	vec2 uv = (vec2(px) + 0.5) / vec2(pc.size);
	float depth = texelFetch(gbDepth, ivec2(px), 0).r;
	vec4 nr = texelFetch(gbNormal, ivec2(px), 0);
	vec3 normal = nr.xyz;

	if(depth <= 0.0 || dot(normal, normal) < 0.5){
		imageStore(reflImage, ivec2(px), vec4(0.0));
		return;
	}
	normal = normalize(normal);

	float u = uv.x*2.0 - 1.0;
	float v = uv.y*2.0 - 1.0;
	vec3 viewRay = pc.camFwd.xyz - pc.camRight.xyz*(u*pc.camRight.w) + pc.camUp.xyz*(v*pc.camUp.w);
	if(dot(normal, viewRay) > 0.0)
		normal = -normal;

	// G-buffer normal.w: < 0 = vehicle base reflectivity (negated),
	// 1.5..2.5 = sea surface, > 2.5 = glass pane, else per-surface wet
	// multiplier (roads 1.0, walls 0.25, foliage absent)
	vec3 viewDir = normalize(viewRay);
	vec3 worldPos = pc.camPos.xyz + viewRay*depth;

	// sea: procedural ripple so the mirror wobbles like swell. The ripple
	// flattens with distance — at grazing incidence a per-pixel perturbed
	// mirror ray alternates sun/sky hits and the horizon dissolves into
	// speckle; coherent far rays reflect the sky smoothly instead
	if(nr.w > 1.5 && nr.w < 2.5){
		float t = float(pc.frame & 0x3FFFu) * 0.03;
		float rip = 1.0 - smoothstep(80.0, 400.0, length(worldPos - pc.camPos.xyz));
		normal.x += rip*(0.055*sin(worldPos.x*0.9 + t*1.7) + 0.04*sin(worldPos.y*1.9 + t*2.3));
		normal.y += rip*(0.055*sin(worldPos.y*0.8 + t*1.3) + 0.04*sin((worldPos.x + worldPos.y)*1.2 + t*1.9));
		normal = normalize(normal);
	}

	float ndv = clamp(dot(-viewDir, normal), 0.0, 1.0);
	float fresnel = pow(1.0 - ndv, 5.0);

	float refl;
	if(nr.w < 0.0)
		// clearcoat-like: near zero looking straight at the panel (the
		// hood must stay clean paint), mirror toward grazing
		refl = clamp(-nr.w * mix(0.08, 2.0, fresnel), 0.0, 0.75);
	else if(nr.w > 2.5)
		// glass pane: smooth dielectric, deterministic mirror shaped by
		// Fresnel — faint head-on (F0 ~ 0.04), full at grazing
		refl = mix(0.04, 0.95, fresnel);
	else if(nr.w > 1.5){
		// the sea is always reflective, mirror toward the horizon —
		// but at night the sky it mirrors is unlit, and the fresnel
		// term then only DARKENS the water (any spatial variation in
		// it reads as banding), so ease the mirror strength down
		refl = mix(0.07, 0.9, fresnel);
		if(pc.sunDir.w <= 0.0)
			refl *= 0.3;
	}
	else
		// wet roads: faint sheen looking straight down, mirror at grazing
		refl = clamp(pc.wetness * clamp(normal.z, 0.0, 1.0) * nr.w * mix(0.06, 0.85, fresnel), 0.0, 0.75);

	if(refl < 0.02){
		imageStore(reflImage, ivec2(px), vec4(0.0));
		return;
	}

	uint state = px.x*7919u + px.y*104729u + pc.frame*15485863u;

	vec3 dir = reflect(viewDir, normal);
	// a water mirror cannot reflect downward: at extreme grazing angles the
	// interpolated normal lets the ray dip below horizontal, punch through
	// the (non-TLAS) water plane and hit the seabed BLAS — whose texture
	// then grids across the horizon
	if(nr.w > 1.5 && nr.w < 2.5 && dir.z < 0.02){
		dir.z = 0.02;
		dir = normalize(dir);
	}
	vec3 origin = worldPos + normal*0.05;

	rayQueryEXT rq;
	rayQueryInitializeEXT(rq, tlas, gl_RayFlagsNoneEXT, 0xFFu, origin, 0.02, dir, 500.0);
	TRAVERSE(rq)

	vec3 radiance;
	if(rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionTriangleEXT){
		float t = rayQueryGetIntersectionTEXT(rq, true);
		uint inst = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true));
		uint geomIdx = uint(rayQueryGetIntersectionGeometryIndexEXT(rq, true));
		uint prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));

		GeomRecord rec = records[inst + geomIdx];

		UintBuf ib = UintBuf(rec.idx);
		FloatBuf vb = FloatBuf(rec.vtx);
		uint i0 = ib.u[prim*3u+0u];
		uint i1 = ib.u[prim*3u+1u];
		uint i2 = ib.u[prim*3u+2u];

		// real albedo: texture fetch at the hit UV; mean color as fallback
		// (low 16 bits = cache slot; bit 16 marks sun portals)
		vec3 albedo = unpackAlbedo(rec.albedo);
		uint slot = rec.texSlot & 0xFFFFu;
		if(slot != 0xFFFFu && rec.uv != uint64_t(0)){
			vec2 bary = rayQueryGetIntersectionBarycentricsEXT(rq, true);
			FloatBuf uvb = FloatBuf(rec.uv);
			vec2 uv0 = vec2(uvb.f[i0*2u], uvb.f[i0*2u+1u]);
			vec2 uv1 = vec2(uvb.f[i1*2u], uvb.f[i1*2u+1u]);
			vec2 uv2 = vec2(uvb.f[i2*2u], uvb.f[i2*2u+1u]);
			vec2 huv = uv0*(1.0 - bary.x - bary.y) + uv1*bary.x + uv2*bary.y;
			albedo = textureLod(texCache[nonuniformEXT(slot)], huv, 0.0).rgb
				* unpackAlbedo(rec.matColor);
		}
		vec3 p0 = vec3(vb.f[i0*3u], vb.f[i0*3u+1u], vb.f[i0*3u+2u]);
		vec3 p1 = vec3(vb.f[i1*3u], vb.f[i1*3u+1u], vb.f[i1*3u+2u]);
		vec3 p2 = vec3(vb.f[i2*3u], vb.f[i2*3u+1u], vb.f[i2*3u+2u]);
		mat4x3 objToWorld = rayQueryGetIntersectionObjectToWorldEXT(rq, true);
		vec3 hitN = normalize(mat3(objToWorld) * cross(p1 - p0, p2 - p0));
		if(dot(hitN, dir) > 0.0)
			hitN = -hitN;
		vec3 hitPos = origin + dir*t;

		vec3 direct = vec3(0.0);
		if(pc.sunDir.w > 0.0){
			float ndl = dot(hitN, normalize(pc.sunDir.xyz));
			if(ndl > 0.0){
				rayQueryEXT srq;
				rayQueryInitializeEXT(srq, tlas,
					gl_RayFlagsTerminateOnFirstHitEXT,
					0xFFu, hitPos + hitN*0.05, 0.02, normalize(pc.sunDir.xyz), 500.0);
				TRAVERSE(srq)
				if(rayQueryGetIntersectionTypeEXT(srq, true) == gl_RayQueryCommittedIntersectionNoneEXT)
					direct = pc.sunColor.rgb * ndl;
			}
		}
		vec3 skyAmb = skyRadiance(hitN) * 0.35;
		// neon/lit windows glow in wet-road and paint reflections;
		// sunColor.w carries the emissive boost knob
		radiance = albedo * (direct + skyAmb)
			+ unpackAlbedo(rec.emissive) * pc.sunColor.w;
	}else{
		radiance = skyRadiance(dir);
	}

	imageStore(reflImage, ivec2(px), vec4(radiance, refl));
}
